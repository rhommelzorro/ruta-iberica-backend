# Copiar a .env y completar. Nunca subir .env con secretos reales.

FLASK_ENV=development
SECRET_KEY=cambiar-por-cadena-larga-aleatoria
JWT_SECRET_KEY=cambiar-por-otra-cadena-larga-aleatoria

# SQLite local (ruta relativa al backend). En PythonAnywhere usar ruta absoluta.
DATABASE_URL=sqlite:///ruta_iberica.db

# URL pública de la API (sin barra final)
PUBLIC_API_URL=http://127.0.0.1:5000

# Frontend / app (para enlaces de verificación y recuperación)
APP_DEEP_LINK_BASE=rutaiberica://auth
WEB_FALLBACK_URL=http://127.0.0.1:5000/auth

# Correo (SMTP). Si falta, la API indica claramente que el correo NO se envió.
MAIL_ENABLED=false
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Ruta Iberica <noreply@ejemplo.com>

# Límites
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_UPLOAD_BYTES=5242880
JWT_ACCESS_TOKEN_HOURS=12

# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
